/* =========================================================
   LUMA CLIENT OPERATIONS DASHBOARD
   STYLE.CSS
   ========================================================= */

:root {
  --bg: #08080d;
  --bg-soft: #0d0d14;
  --sidebar: #0a0a10;
  --card: #111119;
  --card-hover: #151520;
  --border: rgba(255, 255, 255, 0.08);

  --text: #f7f7fb;
  --text-soft: #a5a5b5;
  --text-muted: #707080;

  --primary: #8b5cf6;
  --primary-light: #a78bfa;
  --primary-dark: #6d28d9;

  --green: #34d399;
  --yellow: #fbbf24;
  --red: #fb7185;
  --blue: #60a5fa;

  --shadow: 0 20px 60px rgba(0, 0, 0, 0.35);

  --radius: 18px;
  --radius-small: 12px;

  --transition: 0.25s ease;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: "Inter", sans-serif;
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  overflow-x: hidden;
}

button,
input,
select,
textarea {
  font-family: inherit;
}

button {
  cursor: pointer;
}

button,
input,
select,
textarea {
  outline: none;
}

.hidden {
  display: none !important;
}


/* =========================================================
   SCROLLBAR
   ========================================================= */

::-webkit-scrollbar {
  width: 7px;
}

::-webkit-scrollbar-track {
  background: #08080d;
}

::-webkit-scrollbar-thumb {
  background: #292936;
  border-radius: 20px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--primary);
}


/* =========================================================
   LOGIN SCREEN
   ========================================================= */

.login-screen {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30px;

  background:
    radial-gradient(
      circle at 20% 20%,
      rgba(139, 92, 246, 0.16),
      transparent 30%
    ),
    radial-gradient(
      circle at 80% 80%,
      rgba(96, 165, 250, 0.08),
      transparent 30%
    ),
    #08080d;
}

.login-card {
  width: 100%;
  max-width: 470px;
  padding: 48px;

  background: rgba(17, 17, 25, 0.86);
  border: 1px solid var(--border);
  border-radius: 28px;

  box-shadow:
    0 30px 100px rgba(0, 0, 0, 0.5),
    0 0 80px rgba(139, 92, 246, 0.08);

  backdrop-filter: blur(25px);
}

.login-logo {
  display: flex;
  align-items: center;
  gap: 10px;

  font-family: "Space Grotesk", sans-serif;
  font-size: 26px;
  font-weight: 700;

  margin-bottom: 40px;
}

.login-logo span {
  color: var(--primary-light);
  font-size: 32px;
}

.login-label {
  color: var(--primary-light);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2px;
  margin-bottom: 12px;
}

.login-card h1 {
  font-family: "Space Grotesk", sans-serif;
  font-size: 42px;
  line-height: 1.05;
  margin-bottom: 15px;
}

.login-description {
  color: var(--text-soft);
  line-height: 1.7;
  margin-bottom: 32px;
}

.input-group {
  margin-bottom: 20px;
}

.input-group label {
  display: block;
  color: var(--text-soft);
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 9px;
}

.input-group input {
  width: 100%;
  height: 52px;

  padding: 0 16px;

  color: var(--text);
  background: #0b0b12;

  border: 1px solid var(--border);
  border-radius: 12px;

  transition: var(--transition);
}

.input-group input::placeholder {
  color: #555563;
}

.input-group input:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.1);
}

.password-field {
  position: relative;
}

.password-field input {
  padding-right: 50px;
}

.password-toggle {
  position: absolute;
  right: 8px;
  top: 50%;
  transform: translateY(-50%);

  width: 38px;
  height: 38px;

  color: var(--text-muted);
  background: transparent;
  border: none;
  border-radius: 9px;
}

.password-toggle:hover {
  color: var(--text);
  background: rgba(255, 255, 255, 0.05);
}

.login-btn {
  width: 100%;
  height: 54px;
  margin-top: 8px;
}

.demo-login {
  color: var(--text-muted);
  text-align: center;
  font-size: 12px;
  margin-top: 20px;
}


/* =========================================================
   BUTTONS
   ========================================================= */

.primary-btn,
.secondary-btn,
.danger-btn {
  border: none;
  border-radius: 11px;

  min-height: 44px;
  padding: 0 17px;

  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;

  font-size: 13px;
  font-weight: 700;

  transition: var(--transition);
}

.primary-btn {
  color: white;

  background:
    linear-gradient(
      135deg,
      var(--primary),
      var(--primary-dark)
    );

  box-shadow: 0 10px 25px rgba(109, 40, 217, 0.2);
}

.primary-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 15px 35px rgba(109, 40, 217, 0.3);
}

.secondary-btn {
  color: var(--text);
  background: var(--card);
  border: 1px solid var(--border);
}

.secondary-btn:hover {
  background: var(--card-hover);
  border-color: rgba(139, 92, 246, 0.4);
}

.danger-btn {
  color: #ff9aaa;
  background: rgba(251, 113, 133, 0.08);
  border: 1px solid rgba(251, 113, 133, 0.15);
}

.danger-btn:hover {
  background: rgba(251, 113, 133, 0.15);
}

.text-btn {
  color: var(--primary-light);
  background: transparent;
  border: none;

  font-size: 12px;
  font-weight: 700;
}

.text-btn:hover {
  color: white;
}

.icon-btn {
  position: relative;

  width: 42px;
  height: 42px;

  color: var(--text-soft);
  background: var(--card);

  border: 1px solid var(--border);
  border-radius: 12px;

  transition: var(--transition);
}

.icon-btn:hover {
  color: white;
  border-color: rgba(139, 92, 246, 0.35);
  background: var(--card-hover);
}


/* =========================================================
   APP LAYOUT
   ========================================================= */

.app {
  display: flex;
  min-height: 100vh;
}


/* =========================================================
   SIDEBAR
   ========================================================= */

.sidebar {
  position: fixed;
  left: 0;
  top: 0;

  width: 260px;
  height: 100vh;

  padding: 25px 16px;

  background:
    linear-gradient(
      180deg,
      #0b0b12 0%,
      #08080d 100%
    );

  border-right: 1px solid var(--border);

  display: flex;
  flex-direction: column;

  z-index: 100;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;

  padding: 4px 10px 30px;
}

.brand-icon {
  width: 40px;
  height: 40px;

  display: flex;
  align-items: center;
  justify-content: center;

  color: white;

  background:
    linear-gradient(
      135deg,
      var(--primary),
      var(--primary-dark)
    );

  border-radius: 12px;

  box-shadow: 0 10px 30px rgba(139, 92, 246, 0.25);
}

.brand strong {
  display: block;

  font-family: "Space Grotesk", sans-serif;
  font-size: 17px;
}

.brand span {
  display: block;

  color: var(--text-muted);
  font-size: 10px;

  margin-top: 2px;
}

.sidebar-nav {
  flex: 1;
}

.nav-title {
  color: #565663;

  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.6px;

  padding: 0 12px;
  margin-bottom: 10px;
}

.second-title {
  margin-top: 28px;
}

.nav-item {
  width: 100%;
  height: 46px;

  display: flex;
  align-items: center;
  gap: 13px;

  padding: 0 13px;
  margin-bottom: 5px;

  color: var(--text-muted);
  background: transparent;

  border: 1px solid transparent;
  border-radius: 11px;

  font-size: 13px;
  font-weight: 600;

  text-align: left;

  transition: var(--transition);
}

.nav-item i {
  width: 18px;
  text-align: center;
}

.nav-item:hover {
  color: var(--text);
  background: rgba(255, 255, 255, 0.04);
}

.nav-item.active {
  color: white;

  background:
    linear-gradient(
      90deg,
      rgba(139, 92, 246, 0.17),
      rgba(139, 92, 246, 0.04)
    );

  border-color: rgba(139, 92, 246, 0.15);
}

.nav-item.active i {
  color: var(--primary-light);
}

.sidebar-bottom {
  margin-top: auto;
}

.upgrade-card {
  padding: 16px;

  margin-bottom: 15px;

  background:
    radial-gradient(
      circle at top right,
      rgba(139, 92, 246, 0.18),
      transparent 60%
    ),
    #101019;

  border: 1px solid var(--border);
  border-radius: 15px;
}

.upgrade-icon {
  width: 31px;
  height: 31px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-bottom: 12px;

  color: var(--primary-light);
  background: rgba(139, 92, 246, 0.1);

  border-radius: 9px;
}

.upgrade-card strong {
  display: block;
  font-size: 12px;
  margin-bottom: 6px;
}

.upgrade-card p {
  color: var(--text-muted);
  font-size: 10px;
  line-height: 1.6;
  margin-bottom: 12px;
}

.upgrade-card button {
  width: 100%;
  height: 32px;

  color: white;
  background: rgba(139, 92, 246, 0.12);

  border: 1px solid rgba(139, 92, 246, 0.2);
  border-radius: 8px;

  font-size: 10px;
  font-weight: 700;
}

.upgrade-card button:hover {
  background: rgba(139, 92, 246, 0.2);
}

.logout-btn {
  width: 100%;
  height: 42px;

  display: flex;
  align-items: center;
  gap: 12px;

  padding: 0 13px;

  color: var(--text-muted);
  background: transparent;

  border: none;
  border-radius: 10px;

  font-size: 12px;
  font-weight: 600;
}

.logout-btn:hover {
  color: var(--red);
  background: rgba(251, 113, 133, 0.06);
}


/* =========================================================
   MAIN CONTENT
   ========================================================= */

.main-content {
  width: calc(100% - 260px);
  margin-left: 260px;

  min-height: 100vh;

  padding: 0 35px 50px;
}


/* =========================================================
   TOPBAR
   ========================================================= */

.topbar {
  height: 86px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  border-bottom: 1px solid var(--border);
}

.topbar-title {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.breadcrumb {
  color: var(--text-muted);
  font-size: 10px;
}

.topbar-title h2 {
  font-family: "Space Grotesk", sans-serif;
  font-size: 18px;
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.notification-dot {
  position: absolute;

  top: 9px;
  right: 9px;

  width: 6px;
  height: 6px;

  background: var(--red);
  border: 2px solid var(--card);
  border-radius: 50%;
}

.profile {
  display: flex;
  align-items: center;
  gap: 10px;

  padding-left: 12px;
  margin-left: 5px;

  border-left: 1px solid var(--border);
}

.avatar {
  width: 38px;
  height: 38px;

  display: flex;
  align-items: center;
  justify-content: center;

  color: white;

  background:
    linear-gradient(
      135deg,
      #7c3aed,
      #2563eb
    );

  border-radius: 11px;

  font-size: 11px;
  font-weight: 800;
}

.profile-info strong {
  display: block;
  font-size: 11px;
}

.profile-info span {
  display: block;
  color: var(--text-muted);
  font-size: 9px;
  margin-top: 3px;
}

.profile-arrow {
  color: var(--text-muted);
  font-size: 9px;
  margin-left: 5px;
}

.mobile-menu-btn {
  display: none;

  width: 42px;
  height: 42px;

  color: var(--text);
  background: var(--card);

  border: 1px solid var(--border);
  border-radius: 11px;
}


/* =========================================================
   PAGE SECTIONS
   ========================================================= */

.page-section {
  display: none;
  padding-top: 35px;
}

.page-section.active-section {
  display: block;
}

.welcome-row,
.page-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: 25px;
  margin-bottom: 30px;
}

.eyebrow {
  color: var(--primary-light);

  font-size: 10px;
  font-weight: 800;
  letter-spacing: 2px;

  margin-bottom: 9px;
}

.welcome-row h1,
.page-heading h1 {
  font-family: "Space Grotesk", sans-serif;

  font-size: clamp(28px, 3vw, 38px);
  line-height: 1.1;

  margin-bottom: 8px;
}

.section-description {
  color: var(--text-muted);
  font-size: 12px;
}


/* =========================================================
   STATS
   ========================================================= */

.stats-grid {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 16px;

  margin-bottom: 18px;
}

.stat-card {
  min-width: 0;

  padding: 20px;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.035),
      rgba(255, 255, 255, 0.012)
    ),
    var(--card);

  border: 1px solid var(--border);
  border-radius: var(--radius);

  transition: var(--transition);
}

.stat-card:hover {
  transform: translateY(-3px);
  border-color: rgba(139, 92, 246, 0.2);
}

.stat-top {
  display: flex;
  align-items: center;
  justify-content: space-between;

  color: var(--text-muted);
  font-size: 11px;
}

.stat-icon {
  width: 34px;
  height: 34px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 10px;
  font-size: 12px;
}

.stat-icon.revenue {
  color: var(--green);
  background: rgba(52, 211, 153, 0.09);
}

.stat-icon.pending {
  color: var(--yellow);
  background: rgba(251, 191, 36, 0.09);
}

.stat-icon.expense {
  color: var(--red);
  background: rgba(251, 113, 133, 0.09);
}

.stat-icon.clients {
  color: var(--blue);
  background: rgba(96, 165, 250, 0.09);
}

.stat-value {
  font-family: "Space Grotesk", sans-serif;

  font-size: 26px;
  font-weight: 700;

  margin: 17px 0 10px;
}

.stat-bottom {
  display: flex;
  align-items: center;
  gap: 5px;

  font-size: 9px;
}

.stat-bottom small {
  color: var(--text-muted);
  font-size: 9px;
}

.positive {
  color: var(--green);
}

.warning {
  color: var(--yellow);
}

.negative {
  color: var(--red);
}


/* =========================================================
   DASHBOARD GRID
   ========================================================= */

.dashboard-grid {
  display: grid;

  grid-template-columns:
    minmax(0, 1.6fr)
    minmax(320px, 1fr);

  gap: 18px;

  margin-bottom: 18px;
}

.dashboard-card,
.data-card,
.settings-card,
.report-large-card {
  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.025),
      rgba(255, 255, 255, 0.008)
    ),
    var(--card);

  border: 1px solid var(--border);
  border-radius: var(--radius);

  overflow: hidden;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 15px;

  padding: 20px 21px;

  border-bottom: 1px solid var(--border);
}

.card-header h3 {
  font-size: 13px;
  margin-bottom: 5px;
}

.card-header p {
  color: var(--text-muted);
  font-size: 10px;
}

.card-header select {
  height: 34px;

  padding: 0 10px;

  color: var(--text-soft);
  background: #0c0c13;

  border: 1px solid var(--border);
  border-radius: 8px;

  font-size: 10px;
}


/* =========================================================
   REVENUE CHART
   ========================================================= */

.chart-area {
  height: 285px;

  display: flex;

  padding: 25px 22px 15px;
}

.chart-y-axis {
  width: 42px;

  display: flex;
  flex-direction: column;
  justify-content: space-between;

  padding-bottom: 28px;

  color: var(--text-muted);
  font-size: 8px;
}

.chart {
  position: relative;

  flex: 1;
  height: 100%;
}

.chart-grid-lines {
  position: absolute;
  inset: 0 0 28px 0;

  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.chart-grid-lines span {
  display: block;

  width: 100%;

  border-top: 1px dashed rgba(255, 255, 255, 0.06);
}

.chart-bars {
  position: absolute;

  inset: 0 5px 28px 5px;

  display: flex;
  align-items: flex-end;
  justify-content: space-around;

  gap: 15px;
}

.chart-bar {
  position: relative;

  flex: 1;
  max-width: 45px;

  min-height: 4px;

  background:
    linear-gradient(
      180deg,
      var(--primary-light),
      var(--primary-dark)
    );

  border-radius: 7px 7px 3px 3px;

  opacity: 0.85;

  transition:
    height 0.7s ease,
    opacity 0.2s ease;
}

.chart-bar:hover {
  opacity: 1;
}

.chart-bar::after {
  content: attr(data-value);

  position: absolute;

  left: 50%;
  bottom: calc(100% + 6px);

  transform: translateX(-50%);

  color: var(--text-soft);

  font-size: 8px;

  opacity: 0;
  transition: var(--transition);

  white-space: nowrap;
}

.chart-bar:hover::after {
  opacity: 1;
}

.chart-labels {
  position: absolute;

  left: 0;
  right: 0;
  bottom: 0;

  height: 22px;

  display: flex;
  justify-content: space-around;

  gap: 15px;
}

.chart-labels span {
  flex: 1;

  color: var(--text-muted);

  text-align: center;

  font-size: 8px;
}


/* =========================================================
   ACTIVITY
   ========================================================= */

.activity-list {
  padding: 5px 20px 12px;
}

.activity-item {
  display: flex;
  align-items: center;
  gap: 12px;

  padding: 13px 0;

  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.activity-item:last-child {
  border-bottom: none;
}

.activity-icon {
  width: 32px;
  height: 32px;

  flex: 0 0 32px;

  display: flex;
  align-items: center;
  justify-content: center;

  color: var(--primary-light);
  background: rgba(139, 92, 246, 0.09);

  border-radius: 9px;

  font-size: 10px;
}

.activity-content {
  min-width: 0;
  flex: 1;
}

.activity-content strong {
  display: block;

  color: var(--text-soft);

  font-size: 10px;
  line-height: 1.5;

  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-content span {
  display: block;

  color: var(--text-muted);

  font-size: 8px;
  margin-top: 3px;
}


/* =========================================================
   BOTTOM GRID
   ========================================================= */

.bottom-grid {
  display: grid;

  grid-template-columns:
    1.3fr
    1fr;

  gap: 18px;
}

.mini-task-list {
  padding: 5px 20px 12px;
}

.mini-task {
  display: flex;
  align-items: center;
  gap: 12px;

  padding: 13px 0;

  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.mini-task:last-child {
  border-bottom: none;
}

.task-check {
  width: 18px;
  height: 18px;

  display: flex;
  align-items: center;
  justify-content: center;

  color: transparent;

  border: 1px solid #3b3b48;
  border-radius: 5px;

  cursor: pointer;

  flex: 0 0 18px;
}

.task-check.completed {
  color: white;
  background: var(--primary);
  border-color: var(--primary);
}

.mini-task-content {
  min-width: 0;
  flex: 1;
}

.mini-task-content strong {
  display: block;

  font-size: 10px;

  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-task-content span {
  display: block;

  color: var(--text-muted);

  font-size: 8px;

  margin-top: 3px;
}

.priority {
  padding: 4px 7px;

  border-radius: 6px;

  font-size: 7px;
  font-weight: 800;
  text-transform: uppercase;
}

.priority.high {
  color: #ff9aaa;
  background: rgba(251, 113, 133, 0.08);
}

.priority.medium {
  color: #fcd34d;
  background: rgba(251, 191, 36, 0.08);
}

.priority.low {
  color: #86efac;
  background: rgba(52, 211, 153, 0.08);
}


/* =========================================================
   PAYMENT SUMMARY
   ========================================================= */

.payment-summary {
  padding: 18px 20px 20px;
}

.payment-row {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 9px;
}

.payment-label {
  display: flex;
  align-items: center;
  gap: 8px;

  color: var(--text-soft);
  font-size: 10px;
}

.payment-row strong {
  font-size: 10px;
}

.payment-dot {
  width: 7px;
  height: 7px;

  border-radius: 50%;
}

.payment-dot.paid {
  background: var(--green);
}

.payment-dot.pending-dot {
  background: var(--yellow);
}

.payment-dot.overdue {
  background: var(--red);
}

.payment-progress {
  height: 5px;

  background: #20202a;

  border-radius: 20px;

  overflow: hidden;

  margin-bottom: 17px;
}

.payment-progress span {
  display: block;

  width: 0;
  height: 100%;

  border-radius: inherit;

  transition: width 0.7s ease;
}

#paidProgress {
  background: var(--green);
}

#pendingProgress {
  background: var(--yellow);
}

#overdueProgress {
  background: var(--red)
    }

.payment-progress {
  height: 5px;

  background: #20202a;

  border-radius: 20px;

  overflow: hidden;

  margin-bottom: 17px;
}

.payment-progress span {
  display: block;

  width: 0;
  height: 100%;

  border-radius: inherit;

  transition: width 0.7s ease;
}

#paidProgress {
  background: var(--green);
}

#pendingProgress {
  background: var(--yellow);
}

#overdueProgress {
  background: var(--red);
}


/* =========================================================
   TOOLBAR
   ========================================================= */

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 12px;

  margin-bottom: 18px;
}

.search-box {
  position: relative;

  width: min(360px, 100%);
}

.search-box i {
  position: absolute;

  left: 14px;
  top: 50%;

  transform: translateY(-50%);

  color: var(--text-muted);

  font-size: 11px;
}

.search-box input {
  width: 100%;
  height: 44px;

  padding: 0 15px 0 38px;

  color: var(--text);

  background: var(--card);

  border: 1px solid var(--border);
  border-radius: 11px;

  font-size: 11px;
}

.search-box input::placeholder {
  color: var(--text-muted);
}

.search-box input:focus {
  border-color: rgba(139, 92, 246, 0.4);
}

.toolbar > select {
  height: 44px;

  min-width: 145px;

  padding: 0 12px;

  color: var(--text-soft);
  background: var(--card);

  border: 1px solid var(--border);
  border-radius: 11px;

  font-size: 10px;
}


/* =========================================================
   TABLE
   ========================================================= */

.data-card {
  overflow: hidden;
}

.table-responsive {
  width: 100%;
  overflow-x: auto;
}

table {
  width: 100%;
  min-width: 760px;

  border-collapse: collapse;
}

thead {
  background: rgba(255, 255, 255, 0.018);
}

th {
  color: var(--text-muted);

  font-size: 9px;
  font-weight: 700;

  text-align: left;

  padding: 15px 18px;

  border-bottom: 1px solid var(--border);
}

td {
  color: var(--text-soft);

  font-size: 10px;

  padding: 16px 18px;

  border-bottom: 1px solid rgba(255, 255, 255, 0.045);
}

tbody tr {
  transition: var(--transition);
}

tbody tr:hover {
  background: rgba(255, 255, 255, 0.018);
}

.client-cell {
  display: flex;
  align-items: center;
  gap: 10px;
}

.client-avatar {
  width: 31px;
  height: 31px;

  display: flex;
  align-items: center;
  justify-content: center;

  color: white;

  background:
    linear-gradient(
      135deg,
      #7c3aed,
      #2563eb
    );

  border-radius: 9px;

  font-size: 9px;
  font-weight: 800;
}

.client-cell strong {
  display: block;
  color: var(--text);
  font-size: 10px;
}

.client-cell span {
  display: block;
  color: var(--text-muted);
  font-size: 8px;
  margin-top: 2px;
}

.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;

  padding: 5px 8px;

  border-radius: 7px;

  font-size: 8px;
  font-weight: 700;
}

.status-badge::before {
  content: "";

  width: 5px;
  height: 5px;

  border-radius: 50%;
}

.status-badge.active {
  color: #86efac;
  background: rgba(52, 211, 153, 0.08);
}

.status-badge.active::before {
  background: var(--green);
}

.status-badge.inactive {
  color: #a1a1aa;
  background: rgba(161, 161, 170, 0.08);
}

.status-badge.inactive::before {
  background: #71717a;
}

.status-badge.paid {
  color: #86efac;
  background: rgba(52, 211, 153, 0.08);
}

.status-badge.paid::before {
  background: var(--green);
}

.status-badge.pending {
  color: #fcd34d;
  background: rgba(251, 191, 36, 0.08);
}

.status-badge.pending::before {
  background: var(--yellow);
}

.status-badge.overdue {
  color: #ff9aaa;
  background: rgba(251, 113, 133, 0.08);
}

.status-badge.overdue::before {
  background: var(--red);
}

.table-action {
  width: 30px;
  height: 30px;

  color: var(--text-muted);
  background: transparent;

  border: 1px solid var(--border);
  border-radius: 8px;
}

.table-action:hover {
  color: white;
  border-color: rgba(139, 92, 246, 0.3);
}
/* =========================================================
   INVOICE SUMMARY
   ========================================================= */

.invoice-summary-grid {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 14px;

  margin-bottom: 20px;
}

.summary-box {
  padding: 17px 18px;

  background: var(--card);

  border: 1px solid var(--border);
  border-radius: 14px;
}

.summary-box span {
  display: block;

  color: var(--text-muted);

  font-size: 9px;

  margin-bottom: 8px;
}

.summary-box strong {
  font-family: "Space Grotesk", sans-serif;

  font-size: 20px;
}


/* =========================================================
   EXPENSES
   ========================================================= */

.expense-overview {
  display: grid;

  grid-template-columns:
    1.5fr
    1fr;

  gap: 16px;

  margin-bottom: 18px;
}

.expense-big-card,
.expense-category-card {
  padding: 24px;

  background: var(--card);

  border: 1px solid var(--border);
  border-radius: var(--radius);
}

.expense-big-card span,
.expense-category-card span {
  color: var(--text-muted);
  font-size: 10px;
}

.expense-big-card strong {
  display: block;

  font-family: "Space Grotesk", sans-serif;
  font-size: 34px;

  margin: 10px 0 5px;
}

.expense-big-card p,
.expense-category-card p {
  color: var(--text-muted);
  font-size: 10px;
}

.category-header {
  display: flex;
  justify-content: space-between;
  align-items: center;

  margin-bottom: 15px;
}

.category-header i {
  color: var(--primary-light);
}

.expense-category-card strong {
  display: block;

  font-family: "Space Grotesk", sans-serif;
  font-size: 22px;

  margin-bottom: 5px;
}


/* =========================================================
   TASK STATS
   ========================================================= */

.task-stats {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 14px;

  margin-bottom: 20px;
}

.task-stats > div {
  padding: 17px;

  background: var(--card);

  border: 1px solid var(--border);
  border-radius: 14px;
}

.task-stats span {
  display: block;

  color: var(--text-muted);

  font-size: 9px;

  margin-bottom: 7px;
}

.task-stats strong {
  font-family: "Space Grotesk", sans-serif;
  font-size: 22px;
}

.tasks-container {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 14px;
}

.full-task {
  padding: 18px;

  background: var(--card);

  border: 1px solid var(--border);
  border-radius: 14px;

  transition: var(--transition);
}

.full-task:hover {
  border-color: rgba(139, 92, 246, 0.2);
}

.full-task-top {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 13px;
}

.full-task h3 {
  font-size: 12px;
}

.full-task-description {
  color: var(--text-muted);

  font-size: 9px;
  line-height: 1.6;

  margin-bottom: 16px;
}

.full-task-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;

  color: var(--text-muted);

  font-size: 8px;
}

.completed-task {
  opacity: 0.55;
}

.completed-task h3 {
  text-decoration: line-through;
}


/* =========================================================
   REPORTS
   ========================================================= */
.report-grid {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 15px;

  margin-bottom: 18px;
}

.report-card {
  padding: 21px;

  background: var(--card);

  border: 1px solid var(--border);
  border-radius: var(--radius);
}

.report-icon {
  width: 34px;
  height: 34px;

  display: flex;
  align-items: center;
  justify-content: center;

  color: var(--primary-light);
  background: rgba(139, 92, 246, 0.09);

  border-radius: 9px;

  margin-bottom: 16px;

  font-size: 11px;
}

.report-card span {
  display: block;

  color: var(--text-muted);

  font-size: 9px;

  margin-bottom: 7px;
}

.report-card strong {
  display: block;

  font-family: "Space Grotesk", sans-serif;
  font-size: 23px;

  margin-bottom: 5px;
}

.report-card small {
  color: var(--text-muted);
  font-size: 8px;
}

.report-large-card {
  padding-bottom: 8px;
}

.snapshot-list {
  padding: 8px 20px 20px;
}

.snapshot-row {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 15px 0;

  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.snapshot-row:last-child {
  border-bottom: none;
}

.snapshot-row span {
  color: var(--text-muted);
  font-size: 10px;
}

.snapshot-row strong {
  font-size: 11px;
}


/* =========================================================
   SETTINGS
   ========================================================= */

.settings-card {
  max-width: 900px;
}

.settings-row {
  min-height: 85px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  padding: 20px 22px;

  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.settings-row:last-child {
  border-bottom: none;
}

.settings-info {
  display: flex;
  align-items: center;
  gap: 14px;
}

.settings-icon {
  width: 38px;
  height: 38px;

  display: flex;
  align-items: center;
  justify-content: center;

  color: var(--primary-light);
  background: rgba(139, 92, 246, 0.08);

  border-radius: 10px;
}

.settings-info strong {
  display: block;

  font-size: 11px;

  margin-bottom: 4px;
}

.settings-info p {
  color: var(--text-muted);
  font-size: 9px;
}


/*=========================================================
   TOGGLE SWITCH
   ========================================================= */

.switch {
  position: relative;

  width: 42px;
  height: 23px;

  flex: 0 0 42px;
}

.switch input {
  opacity: 0;
  width: 0;
  height: 0;
}

.switch span {
  position: absolute;
  inset: 0;

  background: #292936;

  border-radius: 30px;

  cursor: pointer;

  transition: var(--transition);
}

.switch span::before {
  content: "";

  position: absolute;

  width: 17px;
  height: 17px;

  left: 3px;
  top: 3px;

  background: #aaa;

  border-radius: 50%;

  transition: var(--transition);
}

.switch input:checked + span {
  background: var(--primary);
}

.switch input:checked + span::before {
  transform: translateX(19px);
  background: white;
}


/* =========================================================
   MODAL
   ========================================================= */

.modal-overlay {
  position: fixed;
  inset: 0;

  display: none;
  align-items: center;
  justify-content: center;

  padding: 20px;

  background: rgba(0, 0, 0, 0.7);

  backdrop-filter: blur(8px);

  z-index: 500;
}

.modal-overlay.show {
  display: flex;
}

.modal {
  width: 100%;
  max-width: 520px;
  max-height: 90vh;

  overflow-y: auto;

  background: #111119;

  border: 1px solid var(--border);
  border-radius: 22px;

  box-shadow: var(--shadow);

  animation: modalIn 0.25s ease;
}

@keyframes modalIn {
  from {
    opacity: 0;
    transform: translateY(15px) scale(0.98);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  padding: 22px;

  border-bottom: 1px solid var(--border);
}

.modal-header h2 {
  font-family: "Space Grotesk", sans-serif;
  font-size: 22px;
}

.modal-close {
  width: 34px;
  height: 34px;

  color: var(--text-muted);
  background: transparent;

  border: 1px solid var(--border);
  border-radius: 9px;
}

.modal-close:hover {
  color: white;
  background: rgba(255, 255, 255, 0.05);
}

.modal-form {
  padding: 22px;
}

.form-grid {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 15px;
}

.form-group {
  margin-bottom: 15px;
}

.form-group.full {
  grid-column: 1 / -1;
}

.form-group label {
  display: block;

  color: var(--text-soft);

  font-size: 10px;
  font-weight: 600;

  margin-bottom: 7px;
}

.form-group input,
.form-group select,
.form-group textarea {
  width: 100%;

  min-height: 43px;

  padding: 10px 12px;

  color: var(--text);

  background: #0b0b12;

  border: 1px solid var(--border);
  border-radius: 9px;

  font-size: 10px;

  resize: vertical;
}

.form-group textarea {
  min-height: 90px;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  border-color: rgba(139, 92, 246, 0.45);
}

.form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;

  padding-top: 8px;
}

.cancel-btn {
  min-height: 43px;

  padding: 0 16px;

  color: var(--text-soft);
  background: transparent;

  border: 1px solid var(--border);
  border-radius: 9px;

  font-size: 10px;
  font-weight: 700;
}

.cancel-btn:hover {
  color: white;
  background: rgba(255, 255, 255, 0.04);
}
/* =========================================================
   LIGHT MODE
   ========================================================= */

body.light-mode {
  --bg: #f5f5f8;
  --bg-soft: #ffffff;
  --sidebar: #ffffff;
  --card: #ffffff;
  --card-hover: #f7f7fa;

  --border: rgba(20, 20, 35, 0.09);

  --text: #171722;
  --text-soft: #565663;
  --text-muted: #858592;

  --shadow: 0 20px 60px rgba(20, 20, 40, 0.1);
}

body.light-mode .sidebar {
  background: #ffffff;
}

body.light-mode .main-content {
  background: #f5f5f8;
}

body.light-mode .stat-card,
body.light-mode .dashboard-card,
body.light-mode .data-card,
body.light-mode .settings-card,
body.light-mode .report-large-card,
body.light-mode .report-card,
body.light-mode .summary-box,
body.light-mode .expense-big-card,
body.light-mode .expense-category-card,
body.light-mode .task-stats > div,
body.light-mode .full-task {
  background: #ffffff;
}

body.light-mode .chart-grid-lines span {
  border-color: rgba(20, 20, 35, 0.07);
}

body.light-mode .chart-card {
  background: white;
}

body.light-mode .card-header select,
body.light-mode .toolbar > select,
body.light-mode .search-box input,
body.light-mode .form-group input,
body.light-mode .form-group select,
body.light-mode .form-group textarea {
  background: #f7f7fa;
  color: var(--text);
}

body.light-mode .icon-btn {
  background: white;
}

body.light-mode .notification-panel,
body.light-mode .modal {
  background: white;
}

body.light-mode .login-screen {
  background: #f5f5f8;
}

body.light-mode .login-card {
  background: rgba(255, 255, 255, 0.9);
}


/* =========================================================
   RESPONSIVE — TABLET
   ========================================================= */

@media (max-width: 1150px) {

  .sidebar {
    width: 225px;
  }

  .main-content {
    width: calc(100% - 225px);
    margin-left: 225px;

    padding-left: 25px;
    padding-right: 25px;
  }

  .stats-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .dashboard-grid {
    grid-template-columns: 1fr;
  }

  .bottom-grid {
    grid-template-columns: 1fr;
  }

  .report-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }
}
/* =========================================================
   RESPONSIVE — SMALL MOBILE
   ========================================================= */

@media (max-width: 500px) {

  .main-content {
    padding-left: 12px;
    padding-right: 12px;
  }

  .stats-grid {
    grid-template-columns: 1fr;
  }

  .invoice-summary-grid,
  .task-stats,
  .report-grid {
    grid-template-columns: 1fr;
  }

  .stat-card {
    padding: 17px;
  }

  .stat-value {
    font-size: 25px;
  }

  .card-header {
    padding: 17px;
  }

  .chart-area {
    height: 245px;
    padding-left: 12px;
    padding-right: 12px;
  }

  .chart-bars {
    gap: 7px;
  }

  .chart-labels {
    gap: 7px;
  }

  .chart-y-axis {
    width: 34px;
  }

  .profile {
    display: none;
  }

  .topbar-actions {
    margin-left: auto;
  }

  .welcome-row h1,
  .page-heading h1 {
    font-size: 29px;
  }

  .toast-container {
    left: 12px;
    right: 12px;
    bottom: 12px;
  }

  .toast {
    min-width: 0;
    width: 100%;
  }

  .settings-row {
    align-items: flex-start;
  }

  .settings-info {
    align-items: flex-start;
  }

}


/* =========================================================
   PRINT
   ========================================================= */

@media print {

  .sidebar,
  .topbar,
  .primary-btn,
  .secondary-btn,
  .notification-panel,
  .toast-container {
    display: none !important;
  }

  .main-content {
    width: 100%;
    margin: 0;
    padding: 0;
  }

  body {
    background: white;
    color: black;
  }

  .page-section {
    display: none !important;
  }

  #reportsSection {
    display: block !important;
  }

  .report-card,
  .report-large-card {
    color: black;
    background: white;
    border: 1px solid #ddd;
  }

}
